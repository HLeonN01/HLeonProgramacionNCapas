@model ML.Empresa
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Form", "Empresa", FormMethod.Post))
{
    <div class="container">
        @Html.HiddenFor(model => model.IdEmpresa)
        <div class="card">
            <div id="googleMap" style="width:100%;height:400px;"></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-4">
                        @Html.LabelFor(model => model.Nombre)
                        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                    </div>
                    <div class="col-4">
                        @Html.LabelFor(model => model.Latitud)
                        @Html.TextBoxFor(model => model.Latitud, new { @class = "form-control" })
                    </div>
                    <div class="col-4">
                        @Html.LabelFor(model => model.Longitud)
                        @Html.TextBoxFor(model => model.Longitud, new { @class = "form-control" })
                    </div>
                </div>
                <br />
                <div class="text-center">
                    <button class="btn btn-success" type="submit">Guardar</button>
                    <a href="@Url.Action("GetAll", "Empresa")" class="btn btn-info">Regresar</a>
                </div>
            </div>
        </div>
    </div>

}

<script>
    function myMap() {
        var mapProp = {
            center: new google.maps.LatLng(19.42847, -99.12766),
            zoom: 10,
        };
        var map = new google.maps.Map(document.getElementById("googleMap"), mapProp);
    

        const marker = new google.maps.marker.AdvancedMarkerElement({
            map,
            position: { lat: 37.4239163, lng: -122.0947209 },
        });

        marker.addListener('click', ({ domEvent, latLng }) => {
            const { target } = domEvent;
        });
    }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCt5qUAX_luLPwkcfUOJutLLavQwVFgcA&callback=myMap"></script>