@model ML.Empresa
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Form", "Empresa", FormMethod.Post))
{
    if (Model.IdEmpresa == 0)
    {
        <div class="text-center">
            <h2 style="color: green">Agregar nueva sucursal</h2>
        </div>
        <hr />
    }
    else
    {
        <div class="text-center">
            <h2 style="color:darkorange">Editar sucursal</h2>
        </div>
        <hr />
    }
    <div class="container" style="display: grid">
        @Html.HiddenFor(model => model.IdEmpresa)
        <div class="card" style="display:grid">
            <div id="map" style="width:1050px;height:300px;"></div>

            <div class="card-body">
                <div class="row">
                    <div class="col-4">
                        @Html.LabelFor(model => model.Nombre)
                        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                    </div>
                    <div class="col-4">
                        @Html.LabelFor(model => model.Latitud)
                        @Html.TextBoxFor(model => model.Latitud, new { @class = "form-control",@id= "latitud", @readonly = "true" })
                    </div>
                    <div class="col-4">
                        @Html.LabelFor(model => model.Longitud)
                        @Html.TextBoxFor(model => model.Longitud, new { @class = "form-control", @id = "longitud", @readonly = "true" })
                    </div>
                </div>
                <br />
                <div class="text-center">
                    <button class="btn btn-success" type="submit">Guardar</button>
                    <a href="@Url.Action("GetAll", "Empresa")" class="btn btn-info">Regresar</a>
                </div>
            </div>
        </div>
    </div>

}

<script>

    const latitud = @Html.Raw(Json.Encode(@Model.Latitud))
    const longitud = @Html.Raw(Json.Encode(@Model.Longitud))
    console.log(parseFloat(latitud))
    function myMap(latitud, longitud) {
        let mapProp = {
            center: new google.maps.LatLng(19.42847, -99.12766),
            zoom: 12
        };
        var map = new google.maps.Map(document.getElementById("map"), mapProp)
        let marker;

        marker = new google.maps.Marker({
            position: { lat: parseFloat(latitud), lng: parseFloat(longitud) },
            map: map,
        });
        
        google.maps.event.addListener(map, "click", function (event) {
            const lat = event.latLng.lat();
            const lng = event.latLng.lng();

            if (marker) {
                marker.setMap(null);
            }
           
            marker = new google.maps.Marker({
                position: { lat: lat, lng: lng },
                map: map,
            });               
            
            document.getElementById("latitud").value = lat.toFixed(4);
            document.getElementById("longitud").value = lng.toFixed(4);

        });
    }

</script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCt5qUAX_luLPwkcfUOJutLLavQwVFgcA&callback=myMap&v=weekly&libraries=marker"
        defer></script>