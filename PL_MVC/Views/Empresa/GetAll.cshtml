@model ML.Empresa
@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #boxEmpresas {
        display: flex;
        justify-content: space-between;
    }
</style>
@if (Model.Empresas.Count > 0 || Model.Empresas != null)
{
    <h5>
        <strong>
            Listado de Empresas
        </strong>
    </h5>
    <hr />
    <div class="text-end">
        <a href="@Url.Action("Form", "Empresa")" class="btn btn-outline-success">
            <i class="bi bi-plus-circle"></i>
        </a>
    </div>
    <div id="boxEmpresas">
        <div>
            @*<gmp-map center="19.42847,-99.12766"
                 zoom="12"
                 map-id="DEMO_MAP_ID"
                 style="height: 400px;
                 width: 600px">
            @foreach (ML.Empresa marcadores in Model.Empresas)
            {
                <gmp-advanced-marker position="@marcadores.Latitud,@marcadores.Longitud"
                                     content="@marcadores.Nombre"></gmp-advanced-marker>
            }
        </gmp-map>*@
                <div id="map" style="width:600px;height:400px;"></div>
        </div>
        <div class="container">
            <div class="row">
                <div class="row padding">
                    @foreach (ML.Empresa empresa in Model.Empresas)
                    {
                        <div class="col-6">
                            <div class="card mt-3" style="width: 14rem;">
                                <div class="card-body">
                                    <h5 class="card-title text-center">@empresa.Nombre</h5>
                                    <div class="text-center">
                                        <a href="@Url.Action("Form", "Empresa", new {IdEmpresa = @empresa.IdEmpresa})" class="text-center btn btn-outline-warning">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "Empresa", new {IdEmpresa = @empresa.IdEmpresa})" class="text-center btn btn-outline-danger" onclick="">
                                            <i class="bi bi-x-circle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container">
        <div>
            <div class="row">
                <gmp-map center="19.42847,-99.12766"
                         zoom="12"
                         map-id="DEMO_MAP_ID"
                         style="height: 400px">
                </gmp-map>
            </div>
        </div>
    </div>
}

<script>
    
    function myMap() {
        let mapProp = {
            center: new google.maps.LatLng(19.42847, -99.12766),
            zoom: 12
        };
        var map = new google.maps.Map(document.getElementById("map"), mapProp);

        const empresas = @Html.Raw(Json.Encode(Model.Empresas));
        empresas.forEach(empresa => {
            const longitud = empresa.Longitud;
            const latitud = empresa.Latitud;
            
            const marker = new google.maps.Marker({
                position: new google.maps.LatLng(latitud, longitud),
                map: map
            });
            const infowindow = new google.maps.InfoWindow({
                content:`<h4>${empresa.Nombre}</h4><p><strong>Latitud:</strong> ${latitud}  <strong>Longitud:</strong> ${longitud}</p>`,
                ariaLabel: "Uluru",
            });

            marker.addListener("click", () => {
                infowindow.open({
                    anchor: marker,
                    map,
                });
            });
        })
        
    }
       
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCt5qUAX_luLPwkcfUOJutLLavQwVFgcA&callback=myMap&v=weekly&libraries=marker"
        defer></script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">            