@model ML.Empresa
@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model.Empresas.Count > 0 || Model.Empresas != null)
{

    <h5>
        <strong>
            Listado de Empresas
        </strong>
    </h5>
    <hr />
    <div class="text-end">
        <a href="@Url.Action("Form", "Empresa")" class="btn btn-success">
            Agregar
        </a>
    </div>
    <div style="justify-content: space-between">
        <div style="justify-content: space-between">
            <div>
                @foreach (ML.Empresa empresa in Model.Empresas)
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <td>Nombre de la empresa</td>
                                <td>Longitud</td>
                                <td>Latitud</td>
                                <td>Acciones</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="Nombre">@empresa.Nombre</td>
                                <td id="Longitud">@empresa.Longitud</td>
                                <td id="Latitud">@empresa.Latitud</td>
                                <td class="justify-content-between">
                                    <a href="@Url.Action("Form", "Empresa", new {IdEmpresa = @empresa.IdEmpresa})" class="text-center btn btn-warning">
                                        Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Empresa", new {IdEmpresa = @empresa.IdEmpresa})" class="text-center btn btn-danger">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>
            <div id="googleMap" style="width:100%;height:400px;"></div>
        </div>
    </div>
}
else
{
    <div class="container">
        <div>
            <div class="row">
                <div id="googleMap" style="width:100%;height:400px;"></div>
            </div>
        </div>
    </div>
}

<script>
    function myMap() {
        var mapProp = {
            center: new google.maps.LatLng(19.42847, -99.12766),
            zoom: 10,
        };
        var map = new google.maps.Map(document.getElementById("googleMap"), mapProp);
    }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCt5qUAX_luLPwkcfUOJutLLavQwVFgcA&callback=myMap"></script>

