
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center">
    <h3>Lista de usuarios</h3>
</div>

<!-- Button trigger modal -->
<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#idModal" onclick="showModal()">
    Agregar usuario
</button>

<!-- Modal -->
<div class="modal fade modal-lg" id="idModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Formulario</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height:400px; overflow-y:auto">
                <div>
                    <h6>Datos Personales</h6>
                    <div class="row">
                        <input id="inptIdUsuario" type="hidden" />   
                        <input id="intpIdDireccion" type="hidden"/>
                        <input id="inptImageBase64" name="ImagenBase64" type="hidden"/>
                        <div class="col-4">
                            <label>Nombre</label>
                            <input type="text" id="inptNombre" class="form-control" onkeypress="SoloLetras(event)" required />
                            <span style="color:red" class="error"></span>
                        </div>
                        <div class="col-4">
                            <label>Apellido Paterno</label>
                            <input type="text" id="inptApellidoPaterno" class="form-control" onkeypress="SoloLetras(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                        <div class="col-4">
                            <label>Apellido Materno</label>
                            <input type="text" id="inptApellidoMaterno" class="form-control" onkeypress="SoloLetras(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <label>CURP</label>
                            <input type="text" id="inptCURP" class="form-control" oninput = "validarInput(this)" required/>
                            <pre id="resultado"></pre>
                        </div>
                        <div class="col-4">
                            <label>FechaNacimiento</label>
                            <input type="text" id="datepicker" class="form-control" required/>
                        </div>
                        <div class="col-4">
                            <label>Genero</label>
                            <br />
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="sexo" id="rdSexoM" value="M">
                                <label class="form-check-label" for="radioMasculino">Masculino</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="sexo" id="rdSexoF" value="F">
                                <label class="form-check-label" for="radioFemenino">Femenino</label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <label>Telefono</label>
                            <input type="number" id="inptTelefono" class="form-control" onkeypress = "SoloNumeros(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                        <div class="col-4">
                            <label>Celular</label>
                            <input type="number" id="inptCelular" class="form-control" onkeypress = "SoloNumeros(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                    </div>
                </div>
                <div>
                    <h6>Datos domiciliarios</h6>
                    <div class="row">
                        <div class="col-4">
                            <label>Calle</label>
                            <input type="text" id="inptCalle" class="form-control" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                        <div class="col-4">
                            <label>Numero Interior</label>
                            <input type="number" id="inptNumeroInterior" class="form-control" onkeypress = "SoloNumeros(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                        <div class="col-4">
                            <label>Numero Exterior</label>
                            <input type="number" id="inptNumeroExterior" class="form-control" onkeypress = "SoloNumeros(event)" required/>
                            <span style="color:red" class="error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <label>Estado</label>
                            <select id="selectEstado" class="form-control" onchange="MunicipioGetByIdEstado()" required>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Municipio</label>
                            <select id="selectMunicipio" class="form-control" onchange="ColoniaGetByIdMunicipio()" required>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Colonia</label>
                            <select id="selectColonia" class="form-control" required>
                            </select>
                        </div>
                    </div>
                </div>

                <div>
                    <h6>Inisio de sesion</h6>
                    <div class="row">
                        <div class="col-4">
                            <label>Nombre Usuario</label>
                            <input type="text" id="inptUserName" class="form-control" required />
                        </div>
                        <div class="col-4">
                            <label>Correo</label>
                            <input type="email" id="inptCorreo" class="form-control" onblur = "ValidarEmail(this)" required/>
                            <span style="color:red" class="errorEmail" id="EmailError"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-4">
                            <label>Contraseña</label>
                            <input type="password" id="inptPassword" class="form-control" required onblur="ValidarPassword(this)" />
                            <span id='errorEmail'></span>
                        </div>
                        <div class="col-lg-4">
                            <label>Confirmar Contraseña</label>
                            <input type="password" id="inptPasswordConfirm" class="form-control" required onblur="ValidarConfirmacionPassword()"/>
                            <span id='message'></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <label>Estatus</label>
                            <div class="form-check form-switch d-flex flex-column align-items-center">
                                <input class="form-check-input" type="checkbox" data-toggle="switch" name="Resend" id="inptEstatus" value="true" checked style="transform: scale(1.2); width: 2.5rem; height: 1.2rem;" required />
                            </div>

                        </div>
                        <div class="col-4">
                            <label>Roles</label>
                            <select id="selectRoles" class="form-control" required>
                            </select>
                        </div>
                        <div class="col-4">
                            <div class="text-center">
                                <img id="idUsuarioImagen" width="100" height="80"
                                     src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSdnWgZDAdXZemvgse9Ky3sguQEMSeVUkxkcsk_ZFvu9uLsbaEAjdfBLamh7giYmG6vWZs&usqp=CAU" />
                            </div>
                            <label>Imagen</label>
                            <input type="file" name="image" class="form-control" id="inptImage" onchange="ValidarImagen(), VisualizarImagen(this), ValidarTamanio(this)" />
                        </div>

                    </div>

                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Regresar</button>
                <button type="button" class="btn btn-success" onclick="Add()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div>

    <table class="table">
        <thead>
            <tr>                
                <th scope="col">UserName</th>
                <th scope="col">Nombre</th>
                <th scope="col">Email</th>
                <th scope="col">Imagen</th>
                <th scope="col">Direccion</th>
                <th scope="col">Rol</th>
                <th scope="col">Editar</th>
                <th scope="col">Eliminar</th>
            </tr>
        </thead>
        <tbody id="Idtbody">
        </tbody>
    </table>

</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Scripts/CRUD/JavaScript/JavaScriptCURD.js"></script>
<script src="~/Scripts/CRUD/Validaciones/ValidacionesCRUD.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
